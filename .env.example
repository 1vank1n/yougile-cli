# Переменные окружения yougile-cli.
# CLI читает окружение процесса и НЕ загружает .env сам:
# экспортируйте переменные вручную (`set -a; . ./.env; set +a`)
# или пользуйтесь `yougile auth login` — ключ сохранится в hosts.yml.

# Персональный токен (приоритетнее YOUGILE_API_KEY)
YOUGILE_TOKEN=

# API-ключ YouGile (yougile auth login или yougile auth keys create)
YOUGILE_API_KEY=

# Хост: yougile.com по умолчанию либо адрес своего сервера
YOUGILE_HOST=yougile.com

# Каталог конфигурации (по умолчанию ~/.config/yougile)
YOUGILE_CONFIG_DIR=

# Редактор для команд с --editor (иначе VISUAL/EDITOR)
YOUGILE_EDITOR=
